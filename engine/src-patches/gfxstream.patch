+// Kolibri debug: KOLIBRI_TEX_TRACE=1 logs texture-array / mipmap calls and the host error.
+static bool kolibriTexTrace() {
+    static const bool on = getenv("KOLIBRI_TEX_TRACE") != nullptr;
+    return on;
+}
+// Kolibri: the guest GLES driver (goldfish GL2Encoder::s_glGenerateMipmap) rejects
+// glGenerateMipmap on GL_BGRA_EXT textures with GL_INVALID_OPERATION before it reaches the
+// host (BGRA is missing from its unsized/color-renderable format lists). Apps that upload
+// BGRA (Irrlicht/Luanti texture arrays) then sample an incomplete texture: black terrain.
+// When such a texture is set to a mipmap min filter, or its level 0 is re-uploaded while
+// it has one, generate the mip chain on the host, as the app asked for.
+static bool kolibriIsMipmapFilter(GLint f) {
+    return f == GL_NEAREST_MIPMAP_NEAREST || f == GL_LINEAR_MIPMAP_NEAREST ||
+           f == GL_NEAREST_MIPMAP_LINEAR || f == GL_LINEAR_MIPMAP_LINEAR;
+}
+static void kolibriBgraAutoMipmap(GLEScontext* ctx, TextureData* texData, GLenum target, GLint level) {
+    if (!texData || level != 0 || !texData->hasStorage || texData->texStorageLevels != 0) return;
+    if (texData->internalFormat != GL_BGRA_EXT && texData->internalFormat != GL_BGRA8_EXT) return;
+    if (!kolibriIsMipmapFilter(texData->getTexParamOr(GL_TEXTURE_MIN_FILTER, GL_NEAREST_MIPMAP_LINEAR))) return;

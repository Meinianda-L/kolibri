+// Kolibri: zero-copy frame delivery to the Kolibri frontend (macOS).
+//
+// Zero-copy presentation: instead of reading every posted frame back to the CPU and
+// streaming it over gRPC (MMAP transport), the engine blits it on the GPU into one of a
+// few IOSurfaces. The frontend wraps the same IOSurfaces as MTLTextures and samples them
+// directly. A small shared header file (KOLIBRI_IOSURFACE_HEADER) carries the IOSurface
+// IDs and the number of the newest finished frame; see kolibri_iosurface_export.cpp.
+#pragma once
+
+#include <cstdint>
+#include <memory>
+
+namespace gfxstream {
+namespace host {
+namespace vk {
+
+class VkEmulation;
+
+class IOSurfaceFrameExporter {
+   public:
+    // Null unless $KOLIBRI_IOSURFACE_HEADER names the header file to publish.
+    static std::unique_ptr<IOSurfaceFrameExporter> createFromEnv(VkEmulation* emulationVk,
+                                                                 uint32_t width, uint32_t height);
+    virtual ~IOSurfaceFrameExporter() = default;
+    // A ColorBuffer was posted to the display: copy it out if a frontend is reading.
+    virtual void post(uint32_t colorBufferHandle) = 0;
+};
+
+}  // namespace vk
+}  // namespace host

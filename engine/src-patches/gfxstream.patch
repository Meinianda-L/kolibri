+VkImage VkEmulation::createImageFromIOSurface(IOSurfaceRef surface, uint32_t width,
+                                              uint32_t height, VkFormat format,
+                                              VkDeviceMemory* outMemory) {
+    auto vk = mDvk;
+    std::lock_guard<std::mutex> lock(mMutex);
+    VkImportMetalIOSurfaceInfoEXT importInfo = {
+        .sType = VK_STRUCTURE_TYPE_IMPORT_METAL_IO_SURFACE_INFO_EXT,
+        .pNext = nullptr,
+        .ioSurface = surface,
+    };
+    const VkImageCreateInfo createInfo = {
+        .sType = VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO,
+        .pNext = &importInfo,
+        .flags = 0,
+        .imageType = VK_IMAGE_TYPE_2D,
+        .format = format,
+        .extent = {width, height, 1},
+        .mipLevels = 1,
+        .arrayLayers = 1,
+        .samples = VK_SAMPLE_COUNT_1_BIT,
+        .tiling = VK_IMAGE_TILING_OPTIMAL,
+        .usage = VK_IMAGE_USAGE_TRANSFER_DST_BIT | VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT,
+        .sharingMode = VK_SHARING_MODE_EXCLUSIVE,
+        .queueFamilyIndexCount = 0,
+        .pQueueFamilyIndices = nullptr,
+        .initialLayout = VK_IMAGE_LAYOUT_UNDEFINED,
+    };
+    VkImage image = VK_NULL_HANDLE;
+    if (vk->vkCreateImage(mDevice, &createInfo, nullptr, &image) != VK_SUCCESS) {
+        GFXSTREAM_ERROR("Kolibri: vkCreateImage from IOSurface failed");
+        return VK_NULL_HANDLE;
+    }
+    // MoltenVK backs the image with the IOSurface; the binding is still required by the API.
+    VkMemoryRequirements reqs;
+    vk->vkGetImageMemoryRequirements(mDevice, image, &reqs);
+    const VkMemoryAllocateInfo allocInfo = {
+        .sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO,
+        .pNext = nullptr,
+        .allocationSize = reqs.size,
+        .memoryTypeIndex = getValidMemoryTypeIndex(reqs.memoryTypeBits,
+                                                   VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT),
+    };
+    VkDeviceMemory memory = VK_NULL_HANDLE;
+    if (vk->vkAllocateMemory(mDevice, &allocInfo, nullptr, &memory) != VK_SUCCESS ||
+        vk->vkBindImageMemory(mDevice, image, memory, 0) != VK_SUCCESS) {
+        GFXSTREAM_ERROR("Kolibri: memory for IOSurface image failed");
+        if (memory) vk->vkFreeMemory(mDevice, memory, nullptr);
+        vk->vkDestroyImage(mDevice, image, nullptr);
+        return VK_NULL_HANDLE;
+    }
+    *outMemory = memory;
+    return image;
+}
+
+void VkEmulation::destroyIOSurfaceImage(VkImage image, VkDeviceMemory memory) {
+    auto vk = mDvk;
+    std::lock_guard<std::mutex> lock(mMutex);
+    if (image) vk->vkDestroyImage(mDevice, image, nullptr);
+    if (memory) vk->vkFreeMemory(mDevice, memory, nullptr);
+}

diff --git a/host/vulkan/kolibri_iosurface_export.cpp b/host/vulkan/kolibri_iosurface_export.cpp
new file mode 100644
index 0000000..343fe82
--- /dev/null
+++ b/host/vulkan/kolibri_iosurface_export.cpp
@@ -0,0 +1,205 @@
+// Kolibri: zero-copy frame delivery to the Kolibri frontend (macOS). See the header.
+//
+// Shared header file layout (little-endian, 128 bytes; the frontend maps it too):
+//   0  u32 magic 'KIOS' (0x534F494B)      4  u32 version (1)
+//   8  u32 width                          12 u32 height
+//   16 u32 pixel format ('BGRA')          20 u32 surface count (4)
+//   24 u32 IOSurfaceID[4]
+//   40 u64 seq       number of the newest finished frame (0: none yet)
+//   48 u32 latest    surface index holding frame `seq`
+//   52 u32 reading   frontend: index it is sampling (0xffffffff: none)
+//   56 u64 heartbeat frontend: CLOCK_UPTIME_RAW ns of its last look; no reader for 1 s
+//                    means nothing is copied
+//   64 u64 publish   engine: CLOCK_UPTIME_RAW ns when frame `seq` finished
+// A frame goes to a surface that is neither the newest, the one before it, nor the one
+// the frontend reads, so a frame being shown is never overwritten.
+#include "kolibri_iosurface_export.h"
+
+#if defined(__APPLE__)
+
+#include <CoreFoundation/CoreFoundation.h>
+#include <IOSurface/IOSurfaceRef.h>
+#include <fcntl.h>
+#include <sys/mman.h>
+#include <time.h>
+#include <unistd.h>
+
+#include <atomic>
+#include <string>
+
+#include "gfxstream/common/logging.h"
+#include "gfxstream/system/System.h"
+#include "vk_common_operations.h"
+
+namespace gfxstream {
+namespace host {
+namespace vk {
+namespace {
+
+constexpr uint32_t kMagic = 0x534F494B;  // 'KIOS'
+constexpr uint32_t kCount = 4;
+constexpr uint32_t kNone = 0xffffffffu;
+constexpr uint64_t kReaderTimeoutNs = 1000ull * 1000ull * 1000ull;
+
+struct alignas(8) SharedHeader {
+    uint32_t magic;
+    uint32_t version;
+    uint32_t width;
+    uint32_t height;
+    uint32_t pixelFormat;
+    uint32_t count;
+    uint32_t ids[kCount];
+    std::atomic<uint64_t> seq;
+    std::atomic<uint32_t> latest;
+    std::atomic<uint32_t> reading;
+    std::atomic<uint64_t> heartbeatNs;
+    std::atomic<uint64_t> publishNs;
+    uint8_t reserved[56];
+};
+static_assert(sizeof(SharedHeader) == 128, "shared layout");
+
+void setNumber(CFMutableDictionaryRef dict, CFStringRef key, int32_t value) {
+    CFNumberRef n = CFNumberCreate(nullptr, kCFNumberSInt32Type, &value);
+    CFDictionarySetValue(dict, key, n);
+    CFRelease(n);
+}
+
+class IOSurfaceFrameExporterImpl : public IOSurfaceFrameExporter {
+   public:
+    IOSurfaceFrameExporterImpl(VkEmulation* vk, uint32_t width, uint32_t height)
+        : mVk(vk), mWidth(width), mHeight(height) {}
+
+    ~IOSurfaceFrameExporterImpl() override {
+        for (auto& s : mSlots) {
+            mVk->destroyIOSurfaceImage(s.image, s.memory);
+            if (s.surface) CFRelease(s.surface);
+        }
+        if (mHeader) {
+            mHeader->magic = 0;
+            munmap(mHeader, sizeof(SharedHeader));
+        }
+    }
+
+    bool init(const std::string& path) {
+        CFMutableDictionaryRef props = CFDictionaryCreateMutable(
+            nullptr, 0, &kCFTypeDictionaryKeyCallBacks, &kCFTypeDictionaryValueCallBacks);
+        setNumber(props, kIOSurfaceWidth, (int32_t)mWidth);
+        setNumber(props, kIOSurfaceHeight, (int32_t)mHeight);
+        setNumber(props, kIOSurfaceBytesPerElement, 4);
+        setNumber(props, kIOSurfacePixelFormat, (int32_t)'BGRA');
+#pragma clang diagnostic push
+#pragma clang diagnostic ignored "-Wdeprecated-declarations"
+        // Found by ID from the frontend process (IOSurfaceLookup); both are local and unsandboxed.
+        CFDictionarySetValue(props, kIOSurfaceIsGlobal, kCFBooleanTrue);
+#pragma clang diagnostic pop
+        bool ok = true;
+        for (auto& s : mSlots) {
+            s.surface = IOSurfaceCreate(props);
+            if (!s.surface) { ok = false; break; }
+            s.image = mVk->createImageFromIOSurface(s.surface, mWidth, mHeight,
+                                                    VK_FORMAT_B8G8R8A8_UNORM, &s.memory);
+            if (!s.image) { ok = false; break; }
+        }
+        CFRelease(props);
+        if (!ok) {
+            GFXSTREAM_ERROR("Kolibri: IOSurface frame export unavailable (surface/image creation)");
+            return false;
+        }
+
+        int fd = open(path.c_str(), O_RDWR | O_CREAT | O_TRUNC, 0600);
+        if (fd < 0 || ftruncate(fd, sizeof(SharedHeader)) != 0) {
+            if (fd >= 0) close(fd);
+            GFXSTREAM_ERROR("Kolibri: cannot create %s", path.c_str());
+            return false;
+        }
+        void* p = mmap(nullptr, sizeof(SharedHeader), PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
+        close(fd);
+        if (p == MAP_FAILED) return false;
+        mHeader = static_cast<SharedHeader*>(p);
+        mHeader->version = 1;
+        mHeader->width = mWidth;
+        mHeader->height = mHeight;
+        mHeader->pixelFormat = 'BGRA';
+        mHeader->count = kCount;
+        for (uint32_t i = 0; i < kCount; i++) mHeader->ids[i] = IOSurfaceGetID(mSlots[i].surface);
+        mHeader->seq.store(0);
+        mHeader->latest.store(kNone);
+        mHeader->reading.store(kNone);
+        mHeader->heartbeatNs.store(0);
+        std::atomic_thread_fence(std::memory_order_release);
+        mHeader->magic = kMagic;  // valid from here on
+        GFXSTREAM_INFO("Kolibri: IOSurface frame export %ux%u via %s", mWidth, mHeight,
+                       path.c_str());
+        return true;
+    }
+
+    void post(uint32_t colorBufferHandle) override {
+        const uint64_t now = clock_gettime_nsec_np(CLOCK_UPTIME_RAW);
+        const uint64_t beat = mHeader->heartbeatNs.load(std::memory_order_relaxed);
+        if (beat == 0 || now - beat > kReaderTimeoutNs) return;  // nobody is watching
+
+        const uint32_t reading = mHeader->reading.load(std::memory_order_acquire);
+        uint32_t target = kNone;
+        for (uint32_t i = 0; i < kCount; i++) {
+            if (i != mLatest && i != mPrevious && i != reading) {
+                target = i;
+                break;
+            }
+        }
+        if (target == kNone) return;
+        Slot& s = mSlots[target];
+        if (!mVk->blitColorBufferToImage(colorBufferHandle, s.image, &s.layout, mWidth, mHeight)) {
+            return;
+        }
+        mPrevious = mLatest;
+        mLatest = target;
+        mHeader->latest.store(target, std::memory_order_relaxed);
+        mHeader->publishNs.store(clock_gettime_nsec_np(CLOCK_UPTIME_RAW), std::memory_order_relaxed);
+        mHeader->seq.fetch_add(1, std::memory_order_release);
+    }
+
+   private:
+    struct Slot {
+        IOSurfaceRef surface = nullptr;
+        VkImage image = VK_NULL_HANDLE;
+        VkDeviceMemory memory = VK_NULL_HANDLE;
+        VkImageLayout layout = VK_IMAGE_LAYOUT_UNDEFINED;
+    };
+    VkEmulation* mVk;
+    const uint32_t mWidth;
+    const uint32_t mHeight;
+    Slot mSlots[kCount];
+    SharedHeader* mHeader = nullptr;
+    uint32_t mLatest = kNone;
+    uint32_t mPrevious = kNone;
+};
+
+}  // namespace
+
+std::unique_ptr<IOSurfaceFrameExporter> IOSurfaceFrameExporter::createFromEnv(
+    VkEmulation* emulationVk, uint32_t width, uint32_t height) {
+    const std::string path = gfxstream::base::getEnvironmentVariable("KOLIBRI_IOSURFACE_HEADER");
+    if (path.empty() || !emulationVk || !width || !height) return nullptr;
+    auto exporter = std::make_unique<IOSurfaceFrameExporterImpl>(emulationVk, width, height);
+    if (!exporter->init(path)) return nullptr;
+    return exporter;
+}

+        target != GL_TEXTURE_CUBE_MAP) return;
+    ctx->dispatcher().glGenerateMipmap(target);
+    unsigned int levels = 0;
+    for (unsigned int size = std::max(texData->width, texData->height); size > 1; size >>= 1) levels++;
+    texData->setMipmapLevelAtLeast(levels);
+}

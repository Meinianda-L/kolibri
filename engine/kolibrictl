PROP_END = "# <<< kolibri device profile"


def device_profile(meta: dict) -> dict:
    """The phone this instance presents: a preset (engine/profiles/*.json) or the
    user's own (profile "custom", fields in meta["custom_profile"])."""
    name = meta.get("profile", "stock")
    if name == "custom":
        return {**load_profile("flagship-120"), "title": "自定义机型", **meta.get("custom_profile", {})}
    f = PROFILES_DIR / f"{name}.json"
    return json.loads(f.read_text()) if f.exists() else {}


def load_profile(name: str) -> dict:
    f = PROFILES_DIR / f"{name}.json"
    if not f.exists():
        die(f"unknown profile {name} (have: {', '.join(sorted(p.stem for p in PROFILES_DIR.glob('*.json')))})")
    return json.loads(f.read_text())


def profile_props(p: dict, build_id: str, incremental: str, release: str = "12") -> list[str]:
    """ro.* overrides appended to /product/etc/build.prop.

    init loads partitions in order system -> system_ext -> vendor -> odm -> product
    and later files override earlier ones before properties are committed, so a
    block at the end of the product build.prop wins without touching any other
    partition. ro.product.model etc. derive from the per-partition values.
    """
    fp = f"{p['brand']}/{p['product']}/{p['device']}:{release}/{build_id}/{incremental}:user/release-keys"
    lines = []
    for part in ("", "product.", "system.", "system_ext.", "vendor.", "odm.", "bootimage."):
        for key in ("brand", "manufacturer", "model", "device", "name"):
            val = p["product"] if key == "name" else p[key]
            lines.append(f"ro.product.{part}{key}={val}")
        lines.append(f"ro.{part.replace('bootimage.', 'bootimage.') if part else ''}build.fingerprint={fp}")
    lines += [
        f"ro.product.board={p['board']}",
        f"ro.board.platform={p['platform']}",
        f"ro.build.product={p['device']}",
        f"ro.build.tags=release-keys",
        f"ro.build.type=user",
        f"ro.build.flavor={p['product']}-user",
        # Build.SOC_MANUFACTURER / SOC_MODEL: games tier on these next to the GPU name, so
        # they must name the same chip as the model and $KOLIBRI_GPU_RENDERER (not "ranchu").
        f"ro.soc.manufacturer={p.get('soc_manufacturer', 'QTI' if p.get('hardware') == 'qcom' else 'Google')}",
    ]
    if p.get("soc_model"):
        lines.append(f"ro.soc.model={p['soc_model']}")
    return [PROP_BEGIN, *lines, PROP_END]


def adb_retry(meta: dict, *args: str, tries: int = 20) -> str:
    for _ in range(tries):
        r = subprocess.run([str(ADB), "-s", serial(meta), *args], capture_output=True, text=True, env=env())
        if r.returncode == 0:
            return (r.stdout + r.stderr).strip()
        time.sleep(1)
    die(f"adb {' '.join(args)} kept failing: {r.stderr.strip()}")


def reboot_and_wait(meta: dict, timeout: float = 240) -> None:
    """Reboot as a cold restart of the whole engine. An in-guest `adb reboot` keeps the
    host's Vulkan objects from before the reboot; with GuestAngle the rebooted guest then
    hits stale handles and the engine aborts (FATAL "Failed to unbox VkImage")."""
    t0 = time.time()
    adb(meta, "shell", "sync", check=False)
    cmd_stop(argparse.Namespace(name=meta["name"]))
    cmd_start(argparse.Namespace(name=meta["name"], window=False, cold=True,
                                 writable_system=bool(meta.get("writable_system")), no_wait=False, timeout=timeout))
    meta.update(load_meta(meta["name"]))   # new pid
    print(f"  rebooted ({time.time() - t0:.0f}s)")


def ensure_root_remount(meta: dict) -> None:
    adb_retry(meta, "root")
    subprocess.run([str(ADB), "-s", serial(meta), "wait-for-device"], env=env(), timeout=60)
    wait_boot(meta, 120)
    out = adb_retry(meta, "remount")
    if "reboot" in out.lower():
        print("  remount needs a reboot (first-time overlay setup)")
        reboot_and_wait(meta)
        adb_retry(meta, "root")
        subprocess.run([str(ADB), "-s", serial(meta), "wait-for-device"], env=env(), timeout=60)
        wait_boot(meta, 120)
        out = adb_retry(meta, "remount")
    print(f"  remount: {out.splitlines()[-1] if out else 'ok'}")



INIT_RC = """# Kolibri guest tuning (installed by kolibrictl provision)
on early-boot
    # UI renders with GL so the engine can snapshot (Vulkan UI blocks quickboot);
    # games still get Vulkan.
    setprop debug.hwui.renderer skiagl

# zram ships as a kernel module and init's own domain may not load modules,
# so a oneshot helper in the su domain (userdebug image) sets it up.
service kolibri_zram /system/bin/sh /system/etc/kolibri-zram.sh
    user root
    group root
    seclabel u:r:su:s0
    oneshot
    disabled

on property:sys.boot_completed=1
    start kolibri_zram
"""

ZRAM_SH = """#!/system/bin/sh
# 1) zram (fast, compressed in RAM)  2) disk swap file (cold pages go to
# the Mac's SSD via the userdata qcow2 instead of staying in physical memory).
if ! grep -q zram0 /proc/swaps; then
  for d in /system_dlkm/lib/modules /vendor/lib/modules /vendor_dlkm/lib/modules /lib/modules; do
    [ -f $d/zsmalloc.ko ] && insmod $d/zsmalloc.ko 2>/dev/null
    [ -f $d/zram.ko ] && insmod $d/zram.ko 2>/dev/null
  done
  if [ -e /sys/block/zram0 ]; then
    echo lz4 > /sys/block/zram0/comp_algorithm 2>/dev/null
    echo $(( $(awk '/MemTotal/{print $2}' /proc/meminfo) / 2 ))K > /sys/block/zram0/disksize
    mkswap /dev/block/zram0 >/dev/null && swapon -p 10 /dev/block/zram0
  fi
fi
SWAPFILE=/data/kolibri.swap
if ! grep -q kolibri.swap /proc/swaps; then
  [ -f $SWAPFILE ] || { dd if=/dev/zero of=$SWAPFILE bs=1048576 count=2048 2>/dev/null && chmod 600 $SWAPFILE && mkswap $SWAPFILE >/dev/null; }
  swapon -p 1 $SWAPFILE 2>/dev/null
fi
echo 100 > /proc/sys/vm/swappiness
"""


# Google Play services core: kept on "overseas" instances (gms=true), removed on CN-clean ones.
GMS_CORE = ["com.google.android.gms", "com.google.android.gsf", "com.android.vending"]

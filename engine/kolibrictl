     "sha1": "5a99183b6d924da606260e45fd41a3eb8eca6eb7", "size": 1872691175,
     "license": "android-sdk-arm-dbt-license", "check": "system-images/android-36/google_apis/arm64-v8a/system.img",
     "root": "arm64-v8a", "into": "system-images/android-36/google_apis"},
]
LICENSE_SOURCES = [REPO_URL + "repository2-3.xml", REPO_URL + "sys-img/google_apis/sys-img2-3.xml"]


def missing_packages() -> list[dict]:
    return [p for p in SDK_PACKAGES if not (SDK / p["check"]).exists()]


def fetch_licenses(ids: set[str]) -> dict:
    import re
    import urllib.request
    out = {}
    for url in LICENSE_SOURCES:
        try:
            xml = urllib.request.urlopen(url, timeout=30).read().decode("utf-8", "replace")
        except OSError:
            continue
        for lid in ids - out.keys():
            m = re.search(rf'<license id="{re.escape(lid)}"[^>]*>(.*?)</license>', xml, re.S)
            if m:
                out[lid] = m.group(1).strip()
    return out


def cmd_setup(a: argparse.Namespace) -> None:
    """kolibrictl setup [--check] [--json] [--accept-licenses] — download the Android
    engine, system image and adb from Google into the SDK (first launch)."""
    missing = missing_packages()
    if a.check:
        info = {"ready": not missing, "sdk": str(SDK), "missing": [p["title"] for p in missing],
                "bytes": sum(p["size"] for p in missing)}
        if missing and a.json:
            info["licenses"] = fetch_licenses({p["license"] for p in missing})
        print(json.dumps(info, ensure_ascii=False) if a.json else
              ("ready" if not missing else "missing: " + ", ".join(info["missing"])))
        return
    if not missing:
        print(json.dumps({"done": True}) if a.json else "everything is installed")
        return
    if not a.accept_licenses:
        die("downloading needs --accept-licenses (Android SDK License Agreement)")
    import hashlib
    import urllib.request
    SDK.mkdir(parents=True, exist_ok=True)
    tmp_dir = KOLIBRI_HOME / "cache" / "sdk-download"
    tmp_dir.mkdir(parents=True, exist_ok=True)
    total = sum(p["size"] for p in missing)
    done_before = 0
    for p in missing:
        zip_path = tmp_dir / p["url"].rsplit("/", 1)[1]
        h = hashlib.sha1()
        got = 0
        last = 0.0
        with urllib.request.urlopen(p["url"], timeout=60) as r, zip_path.open("wb") as f:
            while chunk := r.read(1 << 20):
                f.write(chunk)
                h.update(chunk)
                got += len(chunk)
                if time.time() - last > 0.3:
                    last = time.time()
                    print(json.dumps({"package": p["title"], "done": done_before + got, "total": total}), flush=True)
        if h.hexdigest() != p["sha1"]:
            zip_path.unlink(missing_ok=True)
            die(f"{p['title']}: download is corrupt (SHA-1 mismatch), try again")
        print(json.dumps({"package": p["title"], "done": done_before + got, "total": total, "unpacking": True}), flush=True)
        unpack = tmp_dir / ("unpack-" + p["id"])
        shutil.rmtree(unpack, ignore_errors=True)
        subprocess.run(["ditto", "-x", "-k", str(zip_path), str(unpack)], check=True)
        dest_parent = SDK / p["into"] if p["into"] else SDK
        dest_parent.mkdir(parents=True, exist_ok=True)
        dest = dest_parent / p["root"]
        if dest.exists():
            shutil.rmtree(dest)
        shutil.move(str(unpack / p["root"]), str(dest))
        shutil.rmtree(unpack, ignore_errors=True)
        zip_path.unlink(missing_ok=True)
        done_before += p["size"]
    (KOLIBRI_HOME / "licenses-accepted").write_text(
        "\n".join(sorted({p["license"] for p in SDK_PACKAGES})) + "\n")
    print(json.dumps({"done": True}) if a.json else f"installed into {SDK}", flush=True)


def cmd_stop(a: argparse.Namespace) -> None:
    meta = load_meta(a.name)
    pid = running_pid(meta)
    if not pid:
        print(f"{a.name} not running")
        return
    # Thumbnail for the device list (the last screen), best effort; the
    # resize runs in the background.
    thumb = avd_dir(a.name) / "thumbnail.png"
    try:
        png = subprocess.run([str(ADB), "-s", serial(meta), "exec-out", "screencap", "-p"],
                             capture_output=True, timeout=2.5, env=env()).stdout
        if png.startswith(b"\x89PNG"):
            thumb.write_bytes(png)
            subprocess.Popen(["sips", "-Z", "480", str(thumb)], stdout=subprocess.DEVNULL,
                             stderr=subprocess.DEVNULL, start_new_session=True)
    except subprocess.TimeoutExpired:
        pass
    # Graceful: emulator saves the quickboot snapshot on kill via console.
    adb(meta, "emu", "kill", check=False)
    if getattr(a, "no_wait", False):
        # The UI is free right away; `finish-stop` clears the instance once the save is done
        # (`list` reports it as stopping meanwhile, `start` waits for it).
        stopping_marker(a.name).write_text(str(pid))
        subprocess.Popen([sys.executable, str(Path(__file__).resolve()), "finish-stop", a.name],
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)
        print(f"stopping {a.name} (saving in the background)")
        return
    finish_stop(a.name, pid)
    print(f"stopped {a.name}")


def stopping_marker(name: str) -> Path:
    return avd_dir(name) / "stopping"


def finish_stop(name: str, pid: int) -> None:
    for _ in range(int(130 / 0.1)):
        if not pid_alive(pid):
            break
        time.sleep(0.1)
    else:
        try:
            os.killpg(pid, signal.SIGTERM)
        except (ProcessLookupError, PermissionError):   # exited just now
            pass
    (avd_dir(name) / "frame-iosurface.bin").unlink(missing_ok=True)   # zero-copy header
    meta = load_meta(name)
    if meta.get("pid") == pid:
        meta.pop("pid", None)
        save_meta(name, meta)
    stopping_marker(name).unlink(missing_ok=True)


def cmd_finish_stop(a: argparse.Namespace) -> None:
    try:
        pid = int(stopping_marker(a.name).read_text())
    except (OSError, ValueError):
        return
    finish_stop(a.name, pid)


def wait_stopping(name: str) -> bool:
    """A background stop is still saving: wait for it. True if there was one."""
    marker = stopping_marker(name)
    if not marker.exists():
        return False
    try:
        pid = int(marker.read_text())
    except ValueError:
        pid = 0
    print(f"{name}: waiting for the previous stop to finish saving")
    finish_stop(name, pid) if pid else marker.unlink(missing_ok=True)
    return True


def cmd_list(a: argparse.Namespace) -> None:

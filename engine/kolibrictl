def slim_guest(meta: dict) -> None:
    pkgs = [l.strip() for l in (ENGINE_DIR / "slim/remove.txt").read_text().splitlines()
            if l.strip() and not l.startswith("#")]
    if meta.get("gms"):
        pkgs = [p for p in pkgs if p not in GMS_CORE]
    installed = {l.removeprefix("package:").strip() for l in adb(meta, "shell", "pm", "list", "packages").splitlines()}
    removed = 0
    for pkg in pkgs:
        if pkg in installed:
            r = adb(meta, "shell", "pm", "uninstall", "-k", "--user", "0", pkg, check=False)
            removed += "Success" in r
    print(f"  slim: removed {removed} packages")
    # Fewer cached background processes, Bluetooth off.
    adb(meta, "shell", "device_config", "put", "activity_manager", "max_cached_processes", "6")
    adb(meta, "shell", "device_config", "set_sync_disabled_for_tests", "persistent")
    adb(meta, "shell", "settings", "put", "global", "bluetooth_on", "0")
    adb(meta, "shell", "cmd", "bluetooth_manager", "disable", check=False)
    # PackageManager persists packages.xml on a ~10s delayed write; rebooting before
    # it flushes silently brings every uninstalled package back.
    time.sleep(12)
    adb(meta, "shell", "sync")
    adb(meta, "shell", f"cat > /system/etc/init/kolibri.rc <<'RC'\n{INIT_RC}RC")
    adb(meta, "shell", "chmod 644 /system/etc/init/kolibri.rc")
    adb(meta, "shell", f"cat > /system/etc/kolibri-zram.sh <<'SH'\n{ZRAM_SH}SH")
    adb(meta, "shell", "chmod 755 /system/etc/kolibri-zram.sh")


# Apps that keep a launcher icon; everything else with one is removed for user 0.
KEEP_APPS = {"com.android.settings", "com.android.chrome", "com.android.documentsui",
             "com.google.android.documentsui", "dev.kolibri.launcher"}
FILES_LAUNCHER = "com.android.documentsui.LauncherActivity"


def keep_only_core_apps(meta: dict) -> None:
    out = adb(meta, "shell", "cmd", "package", "query-activities", "--brief",
              "-a", "android.intent.action.MAIN", "-c", "android.intent.category.LAUNCHER", check=False)
    # Only preinstalled apps: games the user installed themselves are never touched.
    system = {l.removeprefix("package:").strip() for l in adb(meta, "shell", "pm", "list", "packages", "-s").splitlines()}
    pkgs = sorted({l.strip().split("/")[0] for l in out.splitlines() if "/" in l} & system)
    keep = KEEP_APPS | ({"com.android.vending"} if meta.get("gms") else set())
    removed = [p for p in pkgs if p not in keep
               and "Success" in adb(meta, "shell", "pm", "uninstall", "-k", "--user", "0", p, check=False)]
    # DocumentsUI ships its "Files" icon disabled on phone images.
    for pkg in ("com.google.android.documentsui", "com.android.documentsui"):
        adb(meta, "shell", "pm", "enable", f"{pkg}/{FILES_LAUNCHER}", check=False)
    # Browser opens straight to a page: no first-run, sign-in or default-browser prompts.
    flags = "_ --disable-fre --no-default-browser-check --no-first-run --disable-signin-promo"
    adb(meta, "shell", f"echo '{flags}' > /data/local/tmp/chrome-command-line; chmod 644 /data/local/tmp/chrome-command-line")
    adb(meta, "shell", "am", "set-debug-app", "--persistent", "com.android.chrome", check=False)
    adb(meta, "shell", "pm", "grant", "com.android.chrome", "android.permission.POST_NOTIFICATIONS", check=False)
    # No connectivity probe to Google (unreachable in CN: Wi-Fi shows "?" and apps think
    # they are offline). The emulated network is always online anyway.
    adb(meta, "shell", "settings", "put", "global", "captive_portal_mode", "0")
    # The emulated Wi-Fi network is normally saved by googlesdksetup, which the slim list
    # removes; without it the guest sits on emulated 5G and games warn about mobile data.
    adb(meta, "shell", "cmd", "wifi", "connect-network", "AndroidWifi", "open", check=False)
    adb(meta, "shell", "am", "force-stop", "com.android.chrome", check=False)
    time.sleep(12)          # let PackageManager flush packages.xml (see slim_guest)
    adb(meta, "shell", "sync")
    left = adb(meta, "shell", "cmd", "package", "query-activities", "--brief",
               "-a", "android.intent.action.MAIN", "-c", "android.intent.category.LAUNCHER", check=False)
    icons = sorted({l.strip().split("/")[0] for l in left.splitlines() if "/" in l})
    print(f"  apps: removed {len(removed)} ({', '.join(removed) or '-'}); icons now: {', '.join(icons)}")


def apply_gms(meta: dict, on: bool) -> str:
    """Google services on (overseas games: login, purchases) or off (CN-clean)."""
    for pkg in GMS_CORE:
        if on:
            adb(meta, "shell", "cmd", "package", "install-existing", "--user", "0", pkg, check=False)
            adb(meta, "shell", "pm", "enable", pkg, check=False)
        else:
            adb(meta, "shell", "pm", "uninstall", "-k", "--user", "0", pkg, check=False)
    time.sleep(12)          # PackageManager writes packages.xml late (see slim_guest)
    adb(meta, "shell", "sync")
    present = {l.removeprefix("package:").strip() for l in adb(meta, "shell", "pm", "list", "packages").splitlines()}
    return ", ".join(f"{p.rsplit('.', 1)[-1]}={'on' if p in present else 'off'}" for p in GMS_CORE)


def apply_root(meta: dict, on: bool) -> str:
    """Root for apps (su). Off hides the su binary; kolibrictl itself uses adbd root, not su."""
    ensure_root_remount(meta)
    if on:
        adb(meta, "shell", f"[ -e {SU_HIDDEN} ] && mv {SU_HIDDEN} {SU_PATH}; true")
    else:
        adb(meta, "shell", f"[ -e {SU_PATH} ] && mv {SU_PATH} {SU_HIDDEN}; true")
    adb(meta, "shell", "sync")
    return "su present" if adb(meta, "shell", f"[ -e {SU_PATH} ] && echo yes", check=False) == "yes" else "su hidden"


# Aurora Store: open-source (GPL) Google Play client, ~9 MB. Every device gets it so games
# can be downloaded without a Play Store app. F-Droid build, pinned by hash.
STORE_URL = "https://f-droid.org/repo/com.aurora.store_76.apk"
STORE_SHA256 = "fd9c75d90d0f4a7c132b9b4a5a2cf1992a45e03b8d8ff988b7dcfbc0db2c4d11"
STORE_PKG = "com.aurora.store"


def store_apk() -> Path:
    """Download (once) and verify the Aurora Store APK."""
    import hashlib
    import urllib.request
    apk = KOLIBRI_HOME / "cache" / STORE_URL.rsplit("/", 1)[1]
    if not apk.exists() or hashlib.sha256(apk.read_bytes()).hexdigest() != STORE_SHA256:
        apk.parent.mkdir(parents=True, exist_ok=True)
        tmp = apk.with_suffix(".part")
        urllib.request.urlretrieve(STORE_URL, tmp)
        if hashlib.sha256(tmp.read_bytes()).hexdigest() != STORE_SHA256:
            tmp.unlink(missing_ok=True)
            die(f"Aurora Store download does not match its pinned hash ({STORE_URL})")
        tmp.rename(apk)
    return apk


def install_store(meta: dict) -> str:
    if adb(meta, "shell", "pm", "path", STORE_PKG, check=False):
        return "already installed"
    out = adb(meta, "install", "-r", "-g", str(store_apk()), check=False)
    return "installed" if "Success" in out else f"failed: {out}"


def cmd_store(a: argparse.Namespace) -> None:
    """kolibrictl store <name> — install Aurora Store on a running device."""
    meta = load_meta(a.name)

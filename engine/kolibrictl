#!/usr/bin/env python3
"""kolibrictl - Kolibri instance manager.

Wraps the Android Emulator engine (QEMU + HVF + gfxstream) into game-tuned
instances. Instances live in ~/.kolibri so they never mix with Android Studio
AVDs. Stdlib only.
"""
from __future__ import annotations

import argparse
import json
import os
import shutil
import signal
import socket
import subprocess
import sys
import time
from pathlib import Path

ENGINE_DIR = Path(__file__).resolve().parent
def _find_sdk() -> Path:
    """An explicit ANDROID_SDK_ROOT/ANDROID_HOME, else Android Studio's SDK if it has the
    emulator, else Kolibri's own (filled by `kolibrictl setup` on first launch)."""
    env_sdk = os.environ.get("ANDROID_SDK_ROOT") or os.environ.get("ANDROID_HOME")
    if env_sdk:
        return Path(env_sdk)
    studio = Path.home() / "Library/Android/sdk"
    if (studio / "emulator/emulator").exists():
        return studio
    return Path(os.environ.get("KOLIBRI_HOME", Path.home() / ".kolibri")) / "sdk"


SDK = _find_sdk()
EMULATOR = SDK / "emulator/emulator"
ADB = SDK / "platform-tools/adb"
KOLIBRI_HOME = Path(os.environ.get("KOLIBRI_HOME", Path.home() / ".kolibri"))
AVD_HOME = KOLIBRI_HOME / "avd"
OLD_HOME = Path.home() / ".voltplay"   # the project's name before Kolibri


def migrate_old_home() -> None:
    """Move ~/.voltplay (instances, keymaps, recordings, logs) to ~/.kolibri once.
    AVD .ini files hold absolute paths and every instance's metadata file was renamed;
    the old path stays as a symlink so anything still pointing there keeps working."""
    if KOLIBRI_HOME.exists() or not OLD_HOME.is_dir() or OLD_HOME.is_symlink():
        return
    for meta in OLD_HOME.glob("avd/*.avd/voltplay.json"):
        pid = json.loads(meta.read_text()).get("pid")
        if pid and pid_alive(pid):
            die(f"{meta.parent.stem} is still running; stop it before the first Kolibri start")
    OLD_HOME.rename(KOLIBRI_HOME)
    OLD_HOME.symlink_to(KOLIBRI_HOME)
    for ini in (KOLIBRI_HOME / "avd").glob("*.ini"):
        ini.write_text(ini.read_text().replace(str(OLD_HOME), str(KOLIBRI_HOME)))
    for meta in (KOLIBRI_HOME / "avd").glob("*.avd/voltplay.json"):
        meta.rename(meta.with_name("kolibri.json"))
    print(f"moved {OLD_HOME} -> {KOLIBRI_HOME}", file=sys.stderr)
DEFAULT_IMAGE = "android-36/google_apis"   # Android 16, kernel 6.x; slimmed to Settings/Files/Browser


def sysimg_rel(image: str) -> str:
    api, tag = image.split("/")
    return f"system-images/{api}/{tag}/arm64-v8a/"

CONSOLE_BASE = 5554  # console = base + 2n, adb = console + 1
GRPC_BASE = 8554     # grpc = base + n


def die(msg: str) -> "NoReturn":  # type: ignore[name-defined]
    print(f"kolibrictl: {msg}", file=sys.stderr)
    sys.exit(1)


def avd_dir(name: str) -> Path:
    return AVD_HOME / f"{name}.avd"


def meta_path(name: str) -> Path:
    return avd_dir(name) / "kolibri.json"


def load_meta(name: str) -> dict:
    p = meta_path(name)
    if not p.exists():
        die(f"no such instance: {name}")
    return json.loads(p.read_text())


def save_meta(name: str, meta: dict) -> None:
    meta_path(name).write_text(json.dumps(meta, indent=2, ensure_ascii=False) + "\n")


def instances() -> list[str]:
    if not AVD_HOME.exists():
        return []
    return sorted(p.stem for p in AVD_HOME.glob("*.avd") if (p / "kolibri.json").exists())


def port_free(port: int) -> bool:
    with socket.socket() as s:
        return s.connect_ex(("127.0.0.1", port)) != 0


def alloc_slot() -> int:
    used = {load_meta(n)["slot"] for n in instances()}
    for slot in range(0, 16):
        if slot in used:
            continue
        if port_free(CONSOLE_BASE + 2 * slot) and port_free(GRPC_BASE + slot):
            return slot
    die("no free instance slot (max 16)")


def env() -> dict:
    e = dict(os.environ)
    e["ANDROID_SDK_ROOT"] = str(SDK)
    e["ANDROID_AVD_HOME"] = str(AVD_HOME)
    return e


def render_config(meta: dict) -> str:
    tpl = (ENGINE_DIR / "avd_template/config.ini").read_text()
    w, h = meta["resolution"]
    return tpl.format(
        name=meta["name"],
        sysdir=sysimg_rel(meta.get("image", "android-36/google_apis")),
        target=meta.get("image", "android-36/google_apis").split("/")[0],
        tag=meta.get("image", "android-36/google_apis").split("/")[1],
        cores=meta["cores"],
        ram=meta["ram_mb"],
        width=w,
        height=h,
        dpi=meta["dpi"],
        vsync=meta["refresh_hz"],
        data_size=meta["data_gb"],
    )


def cmd_create(a: argparse.Namespace) -> None:
    name = a.name
    if not (SDK / sysimg_rel(a.image) / "system.img").exists():
        die(f"system image missing: {SDK / sysimg_rel(a.image)} (sdkmanager --install 'system-images;{a.image.replace('/', ';')};arm64-v8a')")
    if avd_dir(name).exists():
        die(f"instance exists: {name}")
    w, h = (int(x) for x in a.resolution.lower().split("x"))
    meta = {
        "name": name,
        "slot": alloc_slot(),
        "resolution": [w, h],
        "dpi": a.dpi,
        "cores": a.cores,
        "ram_mb": a.ram,
        "refresh_hz": a.refresh,
        "data_gb": a.data,
        "profile": a.profile,
        "image": a.image,
        "gms": a.gms,
        "root": a.root,
        "provisioned": False,
        "created": int(time.time()),
    }
    avd_dir(name).mkdir(parents=True)
    (avd_dir(name) / "config.ini").write_text(render_config(meta))
    write_avd_ini(name, a.image)
    save_meta(name, meta)
    print(f"created {name} (slot {meta['slot']}, {w}x{h}@{a.refresh}Hz, {a.cores}c/{a.ram}MB, profile {a.profile})")


def write_avd_ini(name: str, image: str) -> None:
    (AVD_HOME / f"{name}.ini").write_text(
        f"avd.ini.encoding=UTF-8\npath={avd_dir(name)}\npath.rel=avd/{name}.avd\ntarget={image.split('/')[0]}\n"
    )


def ports(meta: dict) -> tuple[int, int, int]:
    console = CONSOLE_BASE + 2 * meta["slot"]
    return console, console + 1, GRPC_BASE + meta["slot"]


def serial(meta: dict) -> str:
    return f"emulator-{ports(meta)[0]}"


def pid_alive(pid: int) -> bool:
    try:
        os.kill(pid, 0)
        return True
    except OSError:
        return False


def running_pid(meta: dict) -> int | None:
    pid = meta.get("pid")
    return pid if pid and pid_alive(pid) else None


def adb(meta: dict, *args: str, check: bool = True, capture: bool = True) -> str:
    r = subprocess.run([str(ADB), "-s", serial(meta), *args], capture_output=capture, text=True, env=env())
    if check and r.returncode != 0:
        die(f"adb {' '.join(args)} failed: {r.stderr.strip()}")
    return (r.stdout or "").strip()


def wait_boot(meta: dict, timeout: float) -> float:
    t0 = time.time()
    subprocess.run([str(ADB), "-s", serial(meta), "wait-for-device"], env=env(), timeout=timeout)
    while time.time() - t0 < timeout:
        if adb(meta, "shell", "getprop", "sys.boot_completed", check=False) == "1":
            return time.time() - t0
        time.sleep(0.5)
    die(f"boot timed out after {timeout:.0f}s")


# Self-built engine (opt-in per instance: `kolibrictl set <name> engine=src`): the build
# tree of ~/emulator-src (external/qemu, cmake.py --out objs-emu) is itself a runnable
# engine layout; only these entries are cloned out of it (the rest is objects and tests).
SRC_ENGINE = Path(os.environ.get("KOLIBRI_ENGINE_SRC", Path.home() / "emulator-src/objs-emu"))
SRC_ENGINE_ENTRIES = ("emulator", "emulator-check", "qemu", "qemu-img", "lib", "lib64", "bin64",
                      "resources", "crashpad_handler", "netsimd", "mksdcard", "source.properties")


def engine_root(meta: dict) -> Path:
    """The emulator directory to run: an APFS clone of the SDK's engine (no extra disk)
    with Kolibri's shims in front of MoltenVK (GPU name for games) and, for host-GLES
    instances, in front of ANGLE. The SDK itself is never modified.
    engine=src instances run a clone of the engine built from source instead."""
    from_src = meta.get("engine") == "src"
    sdk_engine = SRC_ENGINE if from_src else SDK / "emulator"
    clone = KOLIBRI_HOME / "engine" / ("emulator-src" if from_src else "emulator")
    stamp = clone / ".kolibri-source"
    # The shim tag forces a fresh clone when the shims change (e.g. env var names).
    want = (sdk_engine / "source.properties").read_text() + "\nshims=kolibri-1\n"
    if from_src:   # a rebuild keeps source.properties; key on the binaries instead
        for f in ("qemu/darwin-aarch64/qemu-system-aarch64-headless", "lib64/libgfxstream_backend.dylib", "emulator"):
            st = (sdk_engine / f).stat()
            want += f"{f}={st.st_size}:{int(st.st_mtime)}\n"
    if not stamp.exists() or stamp.read_text() != want:
        if clone.exists():
            shutil.rmtree(clone)
        clone.parent.mkdir(parents=True, exist_ok=True)
        if from_src:
            clone.mkdir()
            for e in SRC_ENGINE_ENTRIES:
                if (sdk_engine / e).exists():
                    subprocess.run(["cp", "-cR", str(sdk_engine / e), str(clone / e)], check=True)
        else:
            subprocess.run(["cp", "-cR", str(sdk_engine), str(clone)], check=True)   # APFS clone
        subprocess.run(["bash", str(ENGINE_DIR / "glshim/build_vk.sh"), str(clone / "lib64/vulkan")], check=True)
        stamp.write_text(want)
    if meta.get("host_gles") and not (clone / "lib64/gles_angle/real/angle_GLESv2.dylib").exists():
        subprocess.run(["bash", str(ENGINE_DIR / "glshim/build.sh"), str(clone / "lib64/gles_angle")], check=True,
                       env={**os.environ, "ANGLE_SRC": str(sdk_engine / "lib64/gles_angle")})
    return clone


def engine_args(meta: dict, a: argparse.Namespace) -> list[str]:
    console, _, grpc = ports(meta)
    args = [
        str(engine_root(meta) / "emulator"), "-avd", meta["name"],
        "-port", str(console),
        "-grpc", str(grpc),          # plain localhost gRPC (no JWT) for the frontend
        "-gpu", meta.get("gpu", "host"),  # host | angle (host-side ANGLE -> Metal)
        "-accel", "on",              # HVF
        "-no-boot-anim",
        "-netdelay", "none", "-netspeed", "full",
        # (QuickbootFileBacked/OnDemandSnapshotLoad cut footprint to ~0.5GB but leave
        # ram.img dirty on stop and break the next restore in engine 36.6: off for now.)
        # AsyncComposeSupport: measured 61.2 -> 68.0 fps in STK (GLES via GuestAngle, display
        # client attached). VulkanBatchedDescriptorSetUpdate added only +0.8 fps and crashes the
        # engine on snapshot restore (FATAL VkDescriptorPool); VirtioGpuNativeSync breaks boot.
        "-feature", "Vulkan,VulkanSnapshots,GLDirectMem,VirtioInput,HostComposition,AsyncComposeSupport,"
                    "-BluetoothEmulation",
    ]
    if meta.get("guest_angle", True) and not meta.get("host_gles"):
        # GLES through ANGLE in the guest -> Vulkan -> gfxstream -> MoltenVK -> Metal.
        # The host GL translator caps at GLES 3.0 on macOS (OpenGL 4.1); games then
        # fall back to legacy paths. ANGLE gives GLES 3.1/3.2.
        args[args.index("-feature") + 1] += ",GuestAngle"
    if meta.get("host_gles"):
        # Host GLES: the guest's GLES goes to the host translator, which
        # reports whatever GLES version host ANGLE supports.
        args[args.index("-feature") + 1] += ",GLESDynamicVersion"
    # Faster restores were tried and don't work on this engine: QuickbootFileBacked restores
    # a frozen guest (adb offline, no frames) and OnDemandSnapshotLoad hangs in the load.
    if meta.get("features"):
        # Per-instance feature overrides, e.g. `kolibrictl set x features=GLESDynamicVersion,-AsyncComposeSupport`:
        # "Name" adds a feature, "-Name" removes a default one.
        i = args.index("-feature") + 1
        feats = [f for f in args[i].split(",") if f]
        for f in str(meta["features"]).split(","):
            f = f.strip()
            if not f:
                continue
            name = f.lstrip("-")
            feats = [x for x in feats if x.lstrip("-") != name]
            feats.append(f)
        args[i] = ",".join(feats)
    if meta.get("hidden_window"):
        # The engine's own (Qt) window exists but stays hidden: GL surfaces get a real
        # display scale, which host-side GL needs (with -no-window it renders 1/4 frames).
        args.append("-qt-hide-window")
    elif not a.window:
        args.append("-no-window")
    if a.cold:
        args += ["-no-snapshot-load"]
    if getattr(a, "wipe", False):
        args += ["-wipe-data"]
    if meta.get("phone_number"):
        args += ["-phone-number", str(meta["phone_number"])]
    if getattr(a, "writable_system", False) or meta.get("writable_system"):
        args.append("-writable-system")
    if meta.get("qemu_args"):
        args += ["-qemu", *meta["qemu_args"]]  # must stay last: everything after -qemu goes to QEMU
    return args


def cmd_start(a: argparse.Namespace) -> None:
    meta = load_meta(a.name)
    if wait_stopping(a.name):
        meta = load_meta(a.name)
    if running_pid(meta):
        print(f"{a.name} already running (pid {meta['pid']})")
        return
    log = avd_dir(a.name) / "engine.log"
    t0 = time.time()
    eng_env = env()
    # Headless (-no-window) engines pick the "none" audio backend: the game is
    # silent and nothing can be recorded. Use CoreAudio like a windowed engine.
    eng_env.setdefault("QEMU_AUDIO_DRV", "coreaudio")
    # On `emu kill` the engine saves the quickboot snapshot, but kills itself after 20 s by
    # default; a 4 GB save can take longer, and a cut-short save means a slow cold boot next
    # time. Give it room (stop no longer blocks the UI while it saves).
    eng_env.setdefault("ANDROID_EMULATOR_WAIT_TIME_BEFORE_KILL", "120")
    if meta.get("engine") == "src":
        # 37.2's CoreAudio voice buffer is only a few periods long; at the default 100 Hz audio
        # timer QEMU refilled ~6% of real time (choppy sound, near-empty gRPC audio stream).
        eng_env.setdefault("QEMU_AUDIO_TIMER_PERIOD", "500")
    # Guest ANGLE: clear attachments with a draw instead of vkCmdClearAttachments. Through
    # gfxstream -> MoltenVK a depth clear inside a render pass is lost, so anything drawn
    # after one (Luanti's wield hand, 3D inventory icons) fails the depth test and vanishes.
    # The engine passes this to the guest as androidboot.hardware.angle_feature_overrides_enabled.
    eng_env["ANGLE_FEATURE_OVERRIDES_ENABLED"] = meta.get("angle_enable", "preferDrawClearOverVkCmdClearAttachments")
    if meta.get("host_angle_metal"):
        # Host-side ANGLE on Metal: keep -gpu host (Vulkan on
        # MoltenVK) but run the GLES translator on EGL-on-EGL backed by the engine's
        # bundled ANGLE, steered to its Metal backend instead of macOS OpenGL 4.1.
        angle = SDK / "emulator/lib64/gles_angle"
        eng_env.update({"ANDROID_EGL_ON_EGL": "1", "ANDROID_EGL_LIB": str(angle / "libEGL.dylib"),
                        "ANDROID_GLESv2_LIB": str(angle / "libGLESv2.dylib"), "ANGLE_DEFAULT_PLATFORM": "metal"})
    # GPU name games see (Vulkan deviceName, and GL_RENDERER via guest ANGLE / host GLES).
    gpu_prof = device_profile(meta)
    # An empty gpu_renderer means "follow the phone model".
    eng_env["KOLIBRI_GPU_RENDERER"] = meta.get("gpu_renderer") or gpu_prof.get("gpu_renderer") or "Adreno (TM) 750"
    if meta.get("host_gles"):
        # GLES layering with open-source parts: guest GLES -> gfxstream -> host ANGLE
        # (Vulkan backend) -> MoltenVK -> Metal, through our shim (engine/glshim), which
        # re-exports the engine's ANGLE and reports a phone GPU name to games.
        prof = device_profile(meta)
        renderer = meta.get("gpu_renderer") or prof.get("gpu_renderer") or "Adreno (TM) 750"
        default_vendor = ("Qualcomm" if "Adreno" in renderer else "ARM" if "Mali" in renderer
                          else "HUAWEI" if "Maleoon" in renderer else "Qualcomm")
        eng_env.update({"ANDROID_EGL_ON_EGL": "1", "ANGLE_DEFAULT_PLATFORM": "vulkan",
                        "KOLIBRI_GPU_RENDERER": renderer,
                        "KOLIBRI_GPU_VENDOR": meta.get("gpu_vendor", prof.get("gpu_vendor", default_vendor))})
        if meta.get("engine") == "src":
            # The self-built gfxstream reports these to the guest driver itself
            # (engine/src-patches/gfxstream.patch): ES 3.2 like other Mac emulators (the host context stays
            # ES 3.1: ANGLE on MoltenVK has no geometry shaders) and a phone-style GL_VERSION
            # without "ANGLE" in it.
            gles_max = str(meta.get("gles_max", "3.2"))
            driver = " V@0615.0" if "Adreno" in renderer else ""
            eng_env.update({"KOLIBRI_GLES_MAX": gles_max,
                            "KOLIBRI_GL_VERSION": meta.get("gl_version") or prof.get("gl_version")
                            or f"OpenGL ES {gles_max}{driver}"})
    # Zero-copy frames (self-built engine): gfxstream blits each posted frame into IOSurfaces
    # and publishes them in this header; the frontend samples them instead of the gRPC stream.
    iosurface_hdr = avd_dir(a.name) / "frame-iosurface.bin"
    iosurface_hdr.unlink(missing_ok=True)
    if meta.get("engine") == "src" and meta.get("iosurface", True):
        eng_env["KOLIBRI_IOSURFACE_HEADER"] = str(iosurface_hdr)
    eng_env.update({k: str(v) for k, v in meta.get("env", {}).items()})
    proc = subprocess.Popen(
        engine_args(meta, a), env=eng_env, stdout=log.open("w"), stderr=subprocess.STDOUT,
        start_new_session=True,
    )
    meta["pid"] = proc.pid
    save_meta(a.name, meta)
    console, adbp, grpc = ports(meta)
    print(f"starting {a.name}: pid {proc.pid}, serial {serial(meta)}, grpc 127.0.0.1:{grpc}, log {log}")
    spawn_audio_watch(a.name)
    if a.no_wait:
        return
    try:
        # Snapshot restore: the guest is live (and gRPC frames/input work) as soon as
        # the engine reports the load; adb reattaching takes ~10s more and isn't needed.
        t_snap = time.time()
        while not a.cold and time.time() - t_snap < 30 and proc.poll() is None:
            text = log.read_text(errors="ignore")
            if "Successfully loaded snapshot" in text:
                print(f"{a.name} resumed from snapshot in {time.time() - t0:.1f}s")
                return
            if "Failed to load snapshot" in text or "Cold boot" in text:
                break
            time.sleep(0.05)
        wait_boot(meta, a.timeout)
        if load_meta(a.name).get("grow_fs"):
            grow_data_fs(meta)
    except SystemExit:
        if proc.poll() is not None:
            print(log.read_text()[-2000:], file=sys.stderr)
        raise
    print(f"{a.name} booted in {time.time() - t0:.1f}s")


# --- Audio watchdog ----------------------------------------------------------
# The guest audio HAL (ranchu, tinyalsa on virtio-snd) sometimes reopens its output
# when a game starts and the new PCM stream never starts on the engine side: every
# pcm_writei then fails with EIO and the game stays silent until it is restarted.
# Restarting the audio HAL (audioserver follows) makes every AudioTrack reconnect.
AUDIO_HAL_TAG = "android.hardware.audio@7.1-impl.ranchu"


def spawn_audio_watch(name: str) -> None:
    pidfile = avd_dir(name) / "audio-watch.pid"
    try:
        old = int(pidfile.read_text())
        if pid_alive(old):
            os.kill(old, signal.SIGTERM)
    except (OSError, ValueError):
        pass
    proc = subprocess.Popen([sys.executable, str(Path(__file__).resolve()), "audio-watch", name],
                            stdin=subprocess.DEVNULL, stdout=(avd_dir(name) / "audio-watch.log").open("a"),
                            stderr=subprocess.STDOUT, start_new_session=True)
    pidfile.write_text(str(proc.pid))


def heal_audio(meta: dict) -> None:
    was_root = adb(meta, "shell", "id", "-u", check=False) == "0"
    if not was_root:
        adb_retry(meta, "root")
        subprocess.run([str(ADB), "-s", serial(meta), "wait-for-device"], env=env(), timeout=30)
    adb(meta, "shell", "for p in $(pidof android.hardware.audio.service android.hardware.audio.service.ranchu); "
        "do kill $p; done", check=False)
    if not was_root:
        adb(meta, "unroot", check=False)


def cmd_audio_watch(a: argparse.Namespace) -> None:
    meta = load_meta(a.name)
    engine = meta.get("pid")
    hits: list[float] = []
    heals: list[float] = []
    log = lambda msg: print(time.strftime("%m-%d %H:%M:%S"), msg, flush=True)  # noqa: E731
    while engine and pid_alive(engine):
        try:
            subprocess.run([str(ADB), "-s", serial(meta), "wait-for-device"], env=env(), timeout=60)
        except subprocess.TimeoutExpired:
            continue
        cat = subprocess.Popen([str(ADB), "-s", serial(meta), "logcat", "-T", "1", "-v", "brief",
                                f"{AUDIO_HAL_TAG}:W", "*:S"], stdout=subprocess.PIPE, text=True, env=env())
        for line in cat.stdout:  # type: ignore[union-attr]
            if "pcm_writei failed" not in line:
                continue
            now = time.time()
            hits = [t for t in hits if now - t < 3] + [now]
            # One write error can be a glitch; a burst means the stream is stuck.
            if len(hits) < 5 or (heals and now - heals[-1] < 20):
                continue
            heals = [t for t in heals if now - t < 600] + [now]
            if len(heals) > 3:
                log("audio still failing after 3 restarts in 10 min; leaving it alone")
                continue
            log("audio output stuck (pcm_writei I/O error); restarting the guest audio HAL")
            cat.terminate()
            try:
                heal_audio(meta)
            except (SystemExit, subprocess.SubprocessError) as e:
                log(f"restart failed: {e}")
            hits.clear()
            break
        cat.wait()
        time.sleep(2)



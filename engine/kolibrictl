WALLPAPER = ENGINE_DIR.parent / "guest/wallpaper/kolibri-wallpaper-2560x1440.png"
DEVICE_WALLPAPER = "/product/media/kolibri_wallpaper.png"


def clear_wallpaper(meta: dict) -> None:
    """Forget the current wallpaper so the default (ro.config.wallpaper) shows after the
    next boot. Only for fresh devices or on request: it drops a wallpaper the user chose."""
    adb(meta, "shell", "rm -f /data/system/users/0/wallpaper /data/system/users/0/wallpaper_orig "
        "/data/system/users/0/wallpaper_lock /data/system/users/0/wallpaper_lock_orig "
        "/data/system/users/0/wallpaper_info.xml; sync", check=False)


def cmd_wallpaper(a: argparse.Namespace) -> None:
    """kolibrictl wallpaper <name> — switch a running instance to the Kolibri wallpaper."""
    meta = load_meta(a.name)
    if not running_pid(meta):
        die(f"{a.name} not running (start it first)")
    adb_retry(meta, "root")
    wait_boot(meta, 60)
    ensure_root_remount(meta)
    write_identity(meta, device_profile(meta))
    clear_wallpaper(meta)
    reboot_and_wait(meta)
    settle(meta)
    print("  snapshot:", adb(meta, "emu", "avd", "snapshot", "save", "default_boot", check=False) or "saved")


def write_identity(meta: dict, prof: dict) -> None:
    """Device identity and frame-rate props at the end of /product/etc/build.prop
    (needs root + remount; applied on the next boot)."""
    build_id = adb(meta, "shell", "getprop", "ro.build.id")
    incremental = adb(meta, "shell", "getprop", "ro.build.version.incremental")
    target = "/product/etc/build.prop"
    adb(meta, "shell", f"sed -i '/^{PROP_BEGIN}/,/^{PROP_END}/d' {target}")
    # No on-screen nav bar: Back/Home/Recents live in the frontend toolbar.
    adb(meta, "shell", f"sed -i '/^qemu.hw.mainkeys=/d' {target}")
    adb(meta, "shell", f"echo qemu.hw.mainkeys=1 >> {target}")
    # Android 14+ caps every app in the "game" category at 60 fps by default
    # (SurfaceFlinger game frame-rate override). A game emulator must not.
    adb(meta, "shell", f"sed -i '/^ro.surface_flinger.game_default_frame_rate_override=/d' {target}")
    adb(meta, "shell", f"echo ro.surface_flinger.game_default_frame_rate_override=0 >> {target}")
    # Kolibri wallpaper as the system default (shown until the user picks another one,
    # and what "reset wallpaper" returns to). WallpaperManager reads ro.config.wallpaper.
    if WALLPAPER.exists():
        adb(meta, "shell", "mkdir -p /product/media")
        adb(meta, "push", str(WALLPAPER), DEVICE_WALLPAPER)
        adb(meta, "shell", f"chmod 644 {DEVICE_WALLPAPER}")
        adb(meta, "shell", f"sed -i '/^ro.config.wallpaper=/d' {target}")
        adb(meta, "shell", f"echo ro.config.wallpaper={DEVICE_WALLPAPER} >> {target}")
    if not prof.get("stock"):
        release = adb(meta, "shell", "getprop", "ro.build.version.release")
        block = "\n".join(profile_props(prof, build_id, incremental, release))
        adb(meta, "shell", f"printf '%b\\n' '{block}' >> {target}")


def cmd_reprofile(a: argparse.Namespace) -> None:
    """kolibrictl reprofile <name> [--profile P] — re-apply a device profile to a running
    instance without re-provisioning, then re-save its boot snapshot."""
    meta = load_meta(a.name)
    if not running_pid(meta):
        die(f"{a.name} not running (start it first)")
    name = a.profile or meta.get("profile", "stock")
    prof = device_profile({**meta, "profile": name})
    adb_retry(meta, "root")
    wait_boot(meta, 60)
    ensure_root_remount(meta)
    write_identity(meta, prof)
    reboot_and_wait(meta)
    meta = load_meta(a.name)
    meta["profile"] = name
    save_meta(a.name, meta)
    settle(meta)
    print(f"{a.name}: profile {name} ({prof.get('title', '')})  model={adb(meta, 'shell', 'getprop', 'ro.product.model')}"
          f"  soc={adb(meta, 'shell', 'getprop', 'ro.soc.model')}")
    print("  snapshot:", adb(meta, "emu", "avd", "snapshot", "save", "default_boot", check=False) or "saved")


def _ns(name: str, **kw) -> argparse.Namespace:
    d = dict(name=name, window=False, cold=False, writable_system=False, no_wait=False, timeout=300)
    d.update(kw)
    return argparse.Namespace(**d)


# Settings the engine reads at boot (config.ini, command line, env): a cold restart applies them.
EDIT_BOOT_KEYS = {"cores", "ram_mb", "resolution", "dpi", "refresh_hz", "phone_number", "gpu_renderer"}
# Phone identity written into /product/etc/build.prop: needs a remount and a reboot.
EDIT_ID_KEYS = {"profile", "custom_profile"}
EDIT_LIVE_KEYS = {"device_name", "root"}


def cmd_edit(a: argparse.Namespace) -> None:
    """kolibrictl edit <name> --json '{"cores":6,"resolution":[1920,1080],...}' — change a
    device's performance, display, phone model/GPU and identity, then re-save its snapshot.
    A stopped device is started for the change and stopped again afterwards."""
    meta = load_meta(a.name)
    want = json.loads(a.json)
    unknown = set(want) - EDIT_BOOT_KEYS - EDIT_ID_KEYS - EDIT_LIVE_KEYS
    if unknown:
        die(f"cannot edit: {', '.join(sorted(unknown))}")
    changes = {k: v for k, v in want.items() if meta.get(k) != v}
    if not changes:
        print(f"{a.name}: nothing to change")
        return
    if "resolution" in changes:
        w, h = (int(x) for x in changes["resolution"])
        if not (320 <= w <= 3840 and 320 <= h <= 3840):
            die("resolution out of range (320-3840)")
        changes["resolution"] = [w, h]
    if changes.get("profile", meta.get("profile")) == "custom" and not {**meta, **changes}.get("custom_profile"):
        die("profile custom needs custom_profile fields")
    was_running = bool(running_pid(meta))
    meta.update(changes)
    save_meta(a.name, meta)
    print(f"{a.name}: " + ", ".join(f"{k}={json.dumps(v, ensure_ascii=False)}" for k, v in changes.items()))

    if EDIT_BOOT_KEYS & changes.keys():
        if was_running:
            cmd_stop(_ns(a.name))
        meta = load_meta(a.name)
        (avd_dir(a.name) / "config.ini").write_text(render_config(meta))
        cmd_start(_ns(a.name, cold=True, writable_system=bool(meta.get("writable_system"))))
    elif not was_running:
        cmd_start(_ns(a.name, writable_system=bool(meta.get("writable_system"))))
    meta = load_meta(a.name)
    adb_retry(meta, "root")
    wait_boot(meta, 120)
    if EDIT_ID_KEYS & changes.keys():
        ensure_root_remount(meta)
        write_identity(meta, device_profile(meta))
        reboot_and_wait(meta)
        adb_retry(meta, "root")
        wait_boot(meta, 120)
    if "root" in changes:
        print("  root:", apply_root(meta, bool(changes["root"])))
    if "refresh_hz" in changes:
        hz = f"{float(meta['refresh_hz']):.1f}"
        for key in ("peak_refresh_rate", "min_refresh_rate"):
            adb(meta, "shell", "settings", "put", "system", key, hz)
    if "device_name" in changes:
        if meta["device_name"]:
            adb(meta, "shell", "settings", "put", "global", "device_name", f"'{meta['device_name']}'")
        else:
            adb(meta, "shell", "settings", "delete", "global", "device_name", check=False)
    settle(meta)
    print("  snapshot:", adb(meta, "emu", "avd", "snapshot", "save", "default_boot", check=False) or "saved")
    if not was_running:
        cmd_stop(_ns(a.name))


def cmd_clone(a: argparse.Namespace) -> None:
    """kolibrictl clone <src> <new> — copy a stopped device (APFS clone: instant, and it
    shares disk blocks until the two diverge). The copy gets its own ports and cold-boots."""
    src = load_meta(a.src)
    if running_pid(src):
        die(f"{a.src} is running; stop it before copying")
    if not a.dst.replace("-", "").replace("_", "").isalnum():
        die("name: letters, digits, - and _ only")
    if avd_dir(a.dst).exists() or (AVD_HOME / f"{a.dst}.ini").exists():
        die(f"instance exists: {a.dst}")
    src_dir = str(avd_dir(a.src).resolve())
    # APFS clone when both sit on the same volume; a plain copy from another drive.
    if subprocess.run(["cp", "-cR", src_dir, str(avd_dir(a.dst))]).returncode != 0:
        shutil.rmtree(avd_dir(a.dst), ignore_errors=True)
        subprocess.run(["cp", "-R", src_dir, str(avd_dir(a.dst))], check=True)
    d = avd_dir(a.dst)
    # Snapshots and runtime files belong to the source engine; the copy starts cold.
    shutil.rmtree(d / "snapshots", ignore_errors=True)
    for pattern in ("*.lock", "engine.log", "frame-*.rgba", "hardware-qemu.ini", "read-snapshot.txt"):
        for f in d.glob(pattern):
            if f.is_dir():
                shutil.rmtree(f, ignore_errors=True)
            else:
                f.unlink(missing_ok=True)
    meta = {**src, "name": a.dst, "slot": alloc_slot(), "created": int(time.time())}
    meta.pop("pid", None)
    save_meta(a.dst, meta)
    (d / "config.ini").write_text(render_config(meta))
    write_avd_ini(a.dst, meta.get("image", DEFAULT_IMAGE))
    print(f"cloned {a.src} -> {a.dst} (slot {meta['slot']})")


# --- Storage -------------------------------------------------------------------
# Each device keeps its disks in its own folder: by default ~/.kolibri/avd/<name>.avd;
# `move` puts it anywhere (e.g. an external drive) and leaves a symlink behind, so the
# engine and every other command keep using the usual path.

def qemu_img(*args: str, check: bool = True) -> subprocess.CompletedProcess:
    return subprocess.run([str(SDK / "emulator" / "qemu-img"), *args], capture_output=True, text=True, check=check)


def dir_bytes(d: Path) -> int:
    r = subprocess.run(["du", "-sk", str(d.resolve())], capture_output=True, text=True)
    return int(r.stdout.split()[0]) * 1024 if r.returncode == 0 and r.stdout else 0


def storage_info(name: str) -> dict:
    meta = load_meta(name)
    d = avd_dir(name)
    real = d.resolve()
    return {
        "name": name,
        "dir": str(real),
        "custom_dir": d.is_symlink(),
        "on_disk": dir_bytes(d),
        "data_gb": meta.get("data_gb", 16),
        "free": shutil.disk_usage(real).free,
        "running": bool(running_pid(meta)),
    }


def cmd_storage(a: argparse.Namespace) -> None:
    info = storage_info(a.name)
    if a.json:
        print(json.dumps(info, ensure_ascii=False))
        return
    print(f"{a.name}: {info['on_disk'] / 2**30:.1f} GB on disk in {info['dir']}, data partition "
          f"{info['data_gb']} GB, {info['free'] / 2**30:.0f} GB free there")


def require_stopped(meta: dict, what: str) -> None:
    if running_pid(meta):
        die(f"{meta['name']} is running; stop it before {what}")


def cmd_clean(a: argparse.Namespace) -> None:
    """kolibrictl clean <name> — give back disk space: drop the snapshots (each keeps old
    copies of every block written since, plus a RAM image) and rewrite the disk images
    compactly. The next start is a cold boot.
    (Space Android frees inside /data can't be reclaimed: this engine's virtio-blk has no
    discard, and /data is metadata-encrypted, so zero-filling doesn't help either.)"""
    meta = load_meta(a.name)
    d = avd_dir(a.name).resolve()
    before = dir_bytes(d)
    if running_pid(meta):
        cmd_stop(_ns(a.name))
    shutil.rmtree(d / "snapshots", ignore_errors=True)
    for img in sorted(d.glob("*.qcow2")):
        info = json.loads(qemu_img("info", "--output=json", str(img)).stdout)
        for sn in info.get("snapshots", []):
            qemu_img("snapshot", "-d", sn["name"], str(img), check=False)
        if info.get("actual-size", 0) < 64 << 20:
            continue
        tmp = img.with_name(img.name + ".compact")
        args = ["convert", "-O", "qcow2"]
        if info.get("backing-filename"):
            args += ["-B", info["backing-filename"], "-o", f"backing_fmt={info.get('backing-filename-format', 'raw')}"]
        r = qemu_img(*args, str(img), str(tmp), check=False)
        if r.returncode != 0 or qemu_img("check", str(tmp), check=False).returncode != 0:
            tmp.unlink(missing_ok=True)
            print(f"  {img.name}: kept as is ({(r.stderr or 'check failed').strip()[:200]})")
            continue
        os.replace(tmp, img)
    for f in ("read-snapshot.txt", "snapshot.trace"):
        (d / f).unlink(missing_ok=True)
    after = dir_bytes(d)
    print(f"cleaned {a.name}: {before / 2**30:.1f} GB -> {after / 2**30:.1f} GB "
          f"(freed {(before - after) / 2**30:.1f} GB)")


def cmd_resize(a: argparse.Namespace) -> None:
    """kolibrictl resize <name> <GB> — grow the data partition (apps, games, downloads)."""
    meta = load_meta(a.name)
    require_stopped(meta, "resizing")
    old = int(meta.get("data_gb", 16))
    if a.gb < old:
        die(f"the data partition can only grow (now {old} GB)")
    if a.gb > 256:
        die("at most 256 GB")
    # The engine checks for 1.2x the data size in free space before every start, even
    # though the image is sparse and only grows with real data.
    free_gb = shutil.disk_usage(avd_dir(a.name).resolve()).free / 2**30
    if a.gb * 1.2 > free_gb:
        die(f"needs {a.gb * 1.2:.0f} GB free on this disk to start afterwards; {free_gb:.0f} GB free")
    if a.gb == old:
        print(f"{a.name}: already {old} GB")
        return
    img = avd_dir(a.name) / "userdata-qemu.img.qcow2"
    if img.exists():
        # Snapshots pin the old disk size; the next start is a cold boot.
        shutil.rmtree(avd_dir(a.name) / "snapshots", ignore_errors=True)
        info = json.loads(qemu_img("info", "--output=json", str(img)).stdout)
        for sn in info.get("snapshots", []):
            qemu_img("snapshot", "-d", sn["name"], str(img), check=False)
        qemu_img("resize", str(img), f"{a.gb}G")
    meta["data_gb"] = a.gb
    meta["grow_fs"] = True  # the filesystem follows on the next boot (grow_data_fs)
    save_meta(a.name, meta)
    (avd_dir(a.name) / "config.ini").write_text(render_config(meta))
    print(f"{a.name}: data partition {old} GB -> {a.gb} GB")


def grow_data_fs(meta: dict) -> None:
    """Grow /data's ext4 into a bigger disk, online. Android only formats /data to the
    full disk on a factory reset; a used filesystem grows as far as ext4's online resize
    allows (about +25% in tests: 8 -> 10 of 12 GB)."""
    was_root = adb(meta, "shell", "id", "-u", check=False) == "0"
    if not was_root:
        adb_retry(meta, "root")
        subprocess.run([str(ADB), "-s", serial(meta), "wait-for-device"], env=env(), timeout=30)
    adb(meta, "shell", "resize2fs $(mount | grep ' /data ' | cut -d' ' -f1)", check=False)
    size = adb(meta, "shell", "df -h /data | tail -1", check=False).split()
    if not was_root:
        adb(meta, "unroot", check=False)
    meta = load_meta(meta["name"])
    meta.pop("grow_fs", None)
    save_meta(meta["name"], meta)
    print(f"  data: {size[1] if len(size) > 1 else '?'} usable")


def cmd_move(a: argparse.Namespace) -> None:
    """kolibrictl move <name> <folder|default> — keep this device's disks in another
    folder (another drive, say). `default` brings it back to ~/.kolibri/avd."""
    meta = load_meta(a.name)
    require_stopped(meta, "moving it")
    link = avd_dir(a.name)
    cur = link.resolve()
    dest = (AVD_HOME if a.dir == "default" else Path(a.dir).expanduser().resolve()) / f"{a.name}.avd"
    if dest == cur:
        print(f"{a.name} is already in {cur.parent}")
        return
    if dest.exists() and not (dest == link and link.is_symlink()):
        die(f"{dest} already exists")
    dest.parent.mkdir(parents=True, exist_ok=True)
    need = dir_bytes(cur)
    if os.stat(dest.parent).st_dev != os.stat(cur).st_dev and shutil.disk_usage(dest.parent).free < need + (1 << 30):
        die(f"not enough space in {dest.parent} (needs {need / 2**30:.1f} GB)")
    if link.is_symlink():
        link.unlink()
    try:
        shutil.move(str(cur), str(dest))  # rename on the same volume, copy + delete across
    except Exception:
        if not link.exists():
            link.symlink_to(cur)
        raise
    if dest != link:
        link.symlink_to(dest)
    print(f"moved {a.name} -> {dest.parent}")


def cmd_rename(a: argparse.Namespace) -> None:
    """kolibrictl rename <name> <new> — rename a stopped device (its next start is a cold boot:
    snapshots carry the old paths)."""
    meta = load_meta(a.name)
    require_stopped(meta, "renaming it")
    if not a.new.replace("-", "").replace("_", "").isalnum():
        die("name: letters, digits, - and _ only")
    if avd_dir(a.new).exists() or (AVD_HOME / f"{a.new}.ini").exists():
        die(f"instance exists: {a.new}")
    old_dir = avd_dir(a.name)
    if old_dir.is_symlink():   # kept in another folder (`move`): rename there, relink here
        real = old_dir.resolve()
        new_real = real.with_name(f"{a.new}.avd")
        real.rename(new_real)
        old_dir.unlink()
        avd_dir(a.new).symlink_to(new_real)
    else:
        old_dir.rename(avd_dir(a.new))
    (AVD_HOME / f"{a.name}.ini").unlink(missing_ok=True)
    d = avd_dir(a.new)
    shutil.rmtree(d / "snapshots", ignore_errors=True)
    for f in ("hardware-qemu.ini", "read-snapshot.txt"):
        (d / f).unlink(missing_ok=True)
    meta["name"] = a.new
    save_meta(a.new, meta)
    (d / "config.ini").write_text(render_config(meta))
    write_avd_ini(a.new, meta.get("image", DEFAULT_IMAGE))
    print(f"renamed {a.name} -> {a.new}")

def cmd_reset(a: argparse.Namespace) -> None:
    """kolibrictl reset <name> — factory reset: wipe apps and data, then provision again
    (same phone model, resolution and performance settings)."""
    meta = load_meta(a.name)
    if running_pid(meta):
        cmd_stop(_ns(a.name))
    shutil.rmtree(avd_dir(a.name) / "snapshots", ignore_errors=True)
    meta = load_meta(a.name)
    meta["provisioned"] = False
    meta.pop("grow_fs", None)  # wipe-data formats /data at the full size
    save_meta(a.name, meta)
    cmd_start(_ns(a.name, cold=True, wipe=True, writable_system=True))
    cmd_provision(argparse.Namespace(name=a.name, profile=None, locale="zh-CN", ram=None, no_slim=False))
    meta = load_meta(a.name)
    settle(meta)
    print("  snapshot:", adb(meta, "emu", "avd", "snapshot", "save", "default_boot", check=False) or "saved")


def cmd_reset_id(a: argparse.Namespace) -> None:
    """kolibrictl reset-id <name> — new Android ID for every app (what games use to tell
    devices apart; IMEI and MAC are not readable by apps since Android 10 / 6)."""
    meta = load_meta(a.name)
    if not running_pid(meta):
        die(f"{a.name} not running (start it first)")
    adb_retry(meta, "root")
    wait_boot(meta, 60)
    before = adb(meta, "shell", "settings", "get", "secure", "android_id", check=False)
    adb(meta, "shell", "rm -f /data/system/users/0/settings_ssaid.xml; sync")
    reboot_and_wait(meta)
    adb_retry(meta, "root")
    wait_boot(meta, 120)
    after = adb(meta, "shell", "settings", "get", "secure", "android_id", check=False)
    print(f"{a.name}: android_id {before} -> {after}")
    settle(meta)
    print("  snapshot:", adb(meta, "emu", "avd", "snapshot", "save", "default_boot", check=False) or "saved")


def cmd_toggle(a: argparse.Namespace) -> None:
    """kolibrictl gms|root <name> on|off — switch a running instance and re-save its snapshot."""
    meta = load_meta(a.name)
    if not running_pid(meta):
        die(f"{a.name} not running (start it first)")
    on = a.state == "on"
    key = a.cmd
    meta[key] = on
    save_meta(a.name, meta)
    adb_retry(meta, "root")
    wait_boot(meta, 60)
    state = apply_gms(meta, on) if key == "gms" else apply_root(meta, on)
    print(f"{a.name}: {key} {'on' if on else 'off'} ({state})")
    if key == "gms":
        # Google services' first start right after install-existing floods system_server and
        # SystemUI ANRs; a clean boot avoids that, and the snapshot must not capture it.
        reboot_and_wait(meta)
    settle(meta)
    print("  snapshot:", adb(meta, "emu", "avd", "snapshot", "save", "default_boot", check=False) or "saved")


def settle(meta: dict, quiet_s: float = 20, timeout: float = 180) -> None:
    """Wait until the guest is idle (load below 2 and no app ANR) before a snapshot."""
    t0 = time.time()
    while time.time() - t0 < timeout:
        load = adb(meta, "shell", "cat /proc/loadavg", check=False).split()
        anr = adb(meta, "shell", "dumpsys activity processes | grep -c notResponding=true", check=False)
        if load and float(load[0]) < 2.0 and anr.strip() in ("", "0"):
            time.sleep(quiet_s)
            return
        time.sleep(5)


def cmd_provision(a: argparse.Namespace) -> None:
    meta = load_meta(a.name)
    profile_name = a.profile or meta["profile"]
    prof = device_profile({**meta, "profile": profile_name})
    t0 = time.time()
    print(f"provisioning {a.name} with profile {profile_name} ({prof.get('title', '')})")

    # 1. The per-instance system overlay lives in the AVD dir; the shared base image stays pristine.
    if running_pid(meta) and not meta.get("writable_system"):
        cmd_stop(argparse.Namespace(name=a.name))
        meta = load_meta(a.name)
    meta["writable_system"] = True
    if a.ram:
        meta["ram_mb"] = a.ram
    save_meta(a.name, meta)
    if running_pid(meta) and a.ram:
        cmd_stop(argparse.Namespace(name=a.name))
        meta = load_meta(a.name)
    (avd_dir(a.name) / "config.ini").write_text(render_config(meta))
    if not running_pid(meta):
        cmd_start(argparse.Namespace(name=a.name, window=False, cold=True, writable_system=True, no_wait=False, timeout=300))
        meta = load_meta(a.name)
    ensure_root_remount(meta)

    # 2. Device identity (on by default; the "stock" profile removes it) and wallpaper.
    write_identity(meta, prof)
    clear_wallpaper(meta)
    # 3. Strip the guest (no GMS, no bloat) + zram + GL UI; applied by the reboot below.
    if not a.no_slim:
        slim_guest(meta)
    # Locale (Chinese by default, like the target audience).
    adb(meta, "shell", "setprop", "persist.sys.locale", a.locale)
    reboot_and_wait(meta)
    adb_retry(meta, "root")
    wait_boot(meta, 120)

    # 4. Unlock the guest frame rate: the panel runs at hw.lcd.vsync, but the
    #    framework caps rendering at 60 unless these are raised.
    hz = f"{float(prof.get('refresh_hz', meta['refresh_hz'])):.1f}"
    for key in ("peak_refresh_rate", "min_refresh_rate"):
        adb(meta, "shell", "settings", "put", "system", key, hz)
    # Game-friendly defaults: no screen timeout, stay awake, faster UI animations.
    adb(meta, "shell", "settings", "put", "system", "screen_off_timeout", "2147483647")
    adb(meta, "shell", "settings", "put", "global", "stay_on_while_plugged_in", "7")
    for k in ("window_animation_scale", "transition_animation_scale", "animator_duration_scale"):
        adb(meta, "shell", "settings", "put", "global", k, "0.5")

    # 5. Kolibri launcher (built by guest/launcher/build.sh), installed when present.
    li = REPO / "guest/launcher/install.sh"
    if li.exists() and (REPO / "guest/launcher/out/KolibriLauncher.apk").exists():
        r = subprocess.run(["bash", str(li), serial(meta)], env=env(), capture_output=True, text=True)
        print("  launcher:", (r.stdout + r.stderr).strip().splitlines()[-1:] or "ok")
    else:
        print("  skip launcher (not built yet: guest/launcher)")

    # 5b. A pure system: the only app icons are Settings, Files and Browser (plus the launcher).
    if not a.no_slim:
        keep_only_core_apps(meta)
    # 5b'. Aurora Store, so games can be downloaded (a user app: slimming never touches it).
    print("  store:", install_store(meta))

    # 5c. Apps get root only when the instance asks for it (anti-cheat and banking apps check su).
    print("  root:", apply_root(meta, bool(meta.get("root", False))), "| gms:", "on" if meta.get("gms") else "off")

    # 6. Verify and freeze a golden snapshot for instant starts.
    model = adb(meta, "shell", "getprop", "ro.product.model")
    rate = adb(meta, "shell", "dumpsys display | grep -m1 -o 'renderFrameRate [0-9.]*'", check=False)
    time.sleep(2)
    swap = adb(meta, "shell", "cat /proc/swaps | tail -n +2 | awk '{print $1, $3/1024 \"MB\"}'", check=False)
    print(f"  swap={swap or 'none'}  hwui={adb(meta, 'shell', 'getprop', 'debug.hwui.renderer')}")
    print(f"  model={model}  locale={adb(meta, 'shell', 'getprop', 'persist.sys.locale')}  {rate}")
    meta = load_meta(a.name)
    meta.update(provisioned=True, profile=profile_name)
    save_meta(a.name, meta)
    print("  snapshot:", adb(meta, "emu", "avd", "snapshot", "save", "kolibri-golden", check=False) or "saved")
    print(f"provisioned {a.name} in {time.time() - t0:.0f}s")


def main() -> None:
    p = argparse.ArgumentParser(prog="kolibrictl", description="Kolibri instance manager")
    sub = p.add_subparsers(dest="cmd", required=True)

    c = sub.add_parser("create", help="create a game-tuned instance")
    c.add_argument("name")
    c.add_argument("--resolution", default="1600x900")
    c.add_argument("--dpi", type=int, default=320)
    c.add_argument("--cores", type=int, default=4)
    c.add_argument("--ram", type=int, default=4096, help="MB (API 36 needs >= 2560)")
    c.add_argument("--refresh", type=int, default=120, help="guest display refresh Hz")
    # The engine refuses to start unless the Mac has 1.2x the data size free (see cmd_resize).
    c.add_argument("--data", type=int, default=16, help="data partition GB")
    c.add_argument("--profile", default="flagship-120", help="device profile (engine/profiles/*.json)")
    c.add_argument("--image", default=DEFAULT_IMAGE, help="guest image api/tag, e.g. android-32/default")
    # Every device is a full phone: Google services and Chrome are always there.
    c.add_argument("--no-gms", dest="gms", action="store_false", help="leave out Google Play services (advanced)")
    c.add_argument("--root", action="store_true", help="give apps root (su); off by default")
    c.set_defaults(fn=cmd_create)

    s = sub.add_parser("start", help="start an instance")
    s.add_argument("name")
    s.add_argument("--window", action="store_true", help="show the engine's own window (debug)")
    s.add_argument("--cold", action="store_true", help="full boot, ignore quickboot snapshot")
    s.add_argument("--writable-system", action="store_true")
    s.add_argument("--no-wait", action="store_true")
    s.add_argument("--timeout", type=float, default=180)
    s.set_defaults(fn=cmd_start)

    sp = sub.add_parser("stop", help="stop (saves quickboot snapshot)")
    sp.add_argument("name")
    sp.add_argument("--no-wait", action="store_true", help="return once the save has started")
    sp.set_defaults(fn=cmd_stop)
    fs = sub.add_parser("finish-stop", help=argparse.SUPPRESS)  # spawned by stop --no-wait
    fs.add_argument("name")
    fs.set_defaults(fn=cmd_finish_stop)

    for nm, fn, hl in (("delete", cmd_delete, "delete instance"),
                       ("info", cmd_info, "show instance info as JSON")):
        x = sub.add_parser(nm, help=hl)
        x.add_argument("name")
        x.set_defaults(fn=fn)

    su = sub.add_parser("setup", help="download the Android engine, system image and adb (first run)")
    su.add_argument("--check", action="store_true", help="only report what is missing")
    su.add_argument("--json", action="store_true")
    su.add_argument("--accept-licenses", action="store_true", help="accept the Android SDK licenses")
    su.set_defaults(fn=cmd_setup)
    rn = sub.add_parser("rename", help="rename a stopped instance")
    rn.add_argument("name")
    rn.add_argument("new")
    rn.set_defaults(fn=cmd_rename)
    sg = sub.add_parser("storage", help="disk usage, data size and folder of an instance")
    sg.add_argument("name")
    sg.add_argument("--json", action="store_true")
    sg.set_defaults(fn=cmd_storage)
    cl = sub.add_parser("clean", help="free disk space (trim, drop snapshots, compact images)")
    cl.add_argument("name")
    cl.set_defaults(fn=cmd_clean)
    rz = sub.add_parser("resize", help="grow the data partition (GB)")
    rz.add_argument("name")
    rz.add_argument("gb", type=int)
    rz.set_defaults(fn=cmd_resize)
    mv = sub.add_parser("move", help="keep an instance's disks in another folder ('default' = ~/.kolibri/avd)")
    mv.add_argument("name")
    mv.add_argument("dir")
    mv.set_defaults(fn=cmd_move)

    aw = sub.add_parser("audio-watch", help=argparse.SUPPRESS)  # started by `start`
    aw.add_argument("name")
    aw.set_defaults(fn=cmd_audio_watch)

    st = sub.add_parser("set", help="set instance options (gpu=host|angle, guest_angle=false, ...)")
    st.add_argument("name")
    st.add_argument("pairs", nargs="+")
    st.set_defaults(fn=cmd_set)

    l = sub.add_parser("list", help="list instances")
    l.add_argument("--json", action="store_true")
    l.set_defaults(fn=cmd_list)

    d = sub.add_parser("adb", help="run adb against an instance")
    d.add_argument("name")
    d.add_argument("args", nargs=argparse.REMAINDER)
    d.set_defaults(fn=cmd_adb)

    sn = sub.add_parser("snapshot", help="save/load/delete a named snapshot")
    sn.add_argument("name")
    sn.add_argument("action", choices=["save", "load", "delete", "list"])
    sn.add_argument("snapshot", nargs="?", default="kolibri-golden")
    sn.set_defaults(fn=cmd_snapshot)

    ed = sub.add_parser("edit", help="change performance, display, phone model/GPU, identity")
    ed.add_argument("name")
    ed.add_argument("--json", required=True, help='e.g. {"cores":6,"ram_mb":6144,"resolution":[1920,1080]}')
    ed.set_defaults(fn=cmd_edit)
    cl = sub.add_parser("clone", help="copy a stopped device")
    cl.add_argument("src")
    cl.add_argument("dst")
    cl.set_defaults(fn=cmd_clone)
    rs = sub.add_parser("reset", help="factory reset (wipe apps and data, provision again)")
    rs.add_argument("name")
    rs.set_defaults(fn=cmd_reset)
    ri = sub.add_parser("reset-id", help="new Android ID for every app")
    ri.add_argument("name")
    ri.set_defaults(fn=cmd_reset_id)
    st = sub.add_parser("store", help="install Aurora Store (open-source Google Play client)")
    st.add_argument("name")
    st.set_defaults(fn=cmd_store)
    wp = sub.add_parser("wallpaper", help="switch a running instance to the Kolibri wallpaper")
    wp.add_argument("name")
    wp.set_defaults(fn=cmd_wallpaper)
    rp = sub.add_parser("reprofile", help="re-apply a device profile to a running instance")
    rp.add_argument("name")
    rp.add_argument("--profile", help="switch to this profile (default: the instance's)")
    rp.set_defaults(fn=cmd_reprofile)
    pv = sub.add_parser("provision", help="apply device profile, 120fps unlock, launcher; save golden snapshot")
    pv.add_argument("name")
    pv.add_argument("--profile", help="override the instance's profile")
    pv.add_argument("--locale", default="zh-CN")
    pv.add_argument("--ram", type=int, help="guest RAM MB (rewrites config; default keeps current)")
    pv.add_argument("--no-slim", action="store_true", help="keep Google apps/services")
    pv.set_defaults(fn=cmd_provision)

    for nm, hl in (("gms", "Google Play services on/off"), ("root", "app root (su) on/off")):
        t = sub.add_parser(nm, help=hl)
        t.add_argument("name")
        t.add_argument("state", choices=["on", "off"])
        t.set_defaults(fn=cmd_toggle, cmd=nm)

    a = p.parse_args()
    migrate_old_home()
    a.fn(a)


if __name__ == "__main__":
    main()

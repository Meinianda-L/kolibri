// Kolibri Launcher (guest/launcher, a Lawnchair fork) as the only home app. Replacing
// Launcher3QuickStep also removes the large-screen taskbar it draws on 12L, which is
// where the on-screen Back/Home/Recents buttons came from: those live in the Mac toolbar.
// build.sh copies the APK here from guest/launcher/out.
android_app_import {
    name: "KolibriLauncher",
    apk: "prebuilt/KolibriLauncher.apk",
    // The build uncompresses dex/JNI libs, which voids the APK's own signature: re-sign it.
    default_dev_cert: true,
    product_specific: true,
    // Also leaves out system parts a game phone never uses (Bluetooth stays: the
    // emulator's vendor partition declares the hardware, and Settings expects its app).
    overrides: [
        "Launcher3QuickStep",
        "BasicDreams", "EasterEgg", "LiveWallpapersPicker", "MusicFX", "Traceur",
        "NfcNci", "Tag", "SecureElement",
        "BuiltInPrintService", "PrintRecommendationService",
        "DynamicSystemInstallationService", "CameraExtensionsProxy",
        "DisplayCutoutEmulationCornerOverlay", "DisplayCutoutEmulationDoubleOverlay", "DisplayCutoutEmulationEmu01Overlay",
        "DisplayCutoutEmulationHoleOverlay", "DisplayCutoutEmulationTallOverlay", "DisplayCutoutEmulationWaterfallOverlay",
        "EmulationPixel2XLOverlay", "EmulationPixel3XLOverlay", "EmulationPixel4Overlay", "EmulationPixel4XLOverlay",
        "EmulationPixel4aOverlay", "EmulationPixel5Overlay",
        "SystemUIEmulationPixel2XLOverlay", "SystemUIEmulationPixel3Overlay", "SystemUIEmulationPixel3XLOverlay",
        "SystemUIEmulationPixel3aOverlay", "SystemUIEmulationPixel3aXLOverlay", "SystemUIEmulationPixel4Overlay",
        "SystemUIEmulationPixel4XLOverlay", "SystemUIEmulationPixel4aOverlay", "SystemUIEmulationPixel5Overlay",
    ],
    // Jetpack WindowManager probes these at runtime; the image has neither.
    optional_uses_libs: [
        "androidx.window.extensions",
        "androidx.window.sidecar",
    ],
}

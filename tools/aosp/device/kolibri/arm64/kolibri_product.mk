# Product partition for a gaming phone: AOSP's handheld product minus the apps games never
# use (messaging, calendar, camera, contacts, clock, gallery, music, search, dialer, photo
# screensaver, wallpaper picker, soft keyboard: the Mac keyboard types directly).
$(call inherit-product, $(SRC_TARGET_DIR)/product/media_product.mk)

PRODUCT_PACKAGES += \
    KolibriLauncher \
    Browser2 \
    SettingsIntelligence \
    frameworks-base-overlays \
    preinstalled-packages-platform-handheld-product.xml

PRODUCT_PACKAGES_DEBUG += \
    frameworks-base-overlays-debug

PRODUCT_PRODUCT_PROPERTIES += \
    ro.com.android.dataroaming?=true \
    ro.config.low_ram=false \
    ro.config.wallpaper=/product/media/kolibri_wallpaper.png \
    persist.sys.locale=zh-CN \
    persist.sys.timezone=Asia/Shanghai

PRODUCT_COPY_FILES += \
    device/sample/etc/apns-full-conf.xml:$(TARGET_COPY_OUT_PRODUCT)/etc/apns-conf.xml

# Dark UI, uncapped refresh rate, game-friendly quick settings and defaults.
PRODUCT_PACKAGE_OVERLAYS += device/kolibri/arm64/overlay

# Wallpaper, boot-time device profiles (generated by build.sh) and memory setup.
PRODUCT_COPY_FILES += \
    device/kolibri/arm64/media/kolibri_wallpaper.png:$(TARGET_COPY_OUT_PRODUCT)/media/kolibri_wallpaper.png \
    device/kolibri/arm64/init/kolibri.rc:$(TARGET_COPY_OUT_PRODUCT)/etc/init/kolibri.rc \
    device/kolibri/arm64/init/swap.sh:$(TARGET_COPY_OUT_PRODUCT)/etc/kolibri/swap.sh \
    $(foreach f,$(wildcard device/kolibri/arm64/profiles/*.prop),\
        $(f):$(TARGET_COPY_OUT_PRODUCT)/etc/kolibri/profiles/$(notdir $(f)))
